# 复制为 .env 后填写（勿将含真实密钥的 .env 提交到 Git）

# DeepSeek OpenAI 兼容接口：用于「数据类咨询」、复合兜底与「推荐阅读」（馆藏事实 + 图谱组织话术）
DEEPSEEK_API_KEY=""
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TEMPERATURE=0.6
DEEPSEEK_MAX_TOKENS=1024

# 本地 Ollama（可选，对齐 library-RAG-Rasa 参考仓库的生成层）：配置后「作者介绍 / 主题荐书」优先走本地模型，失败回退 DeepSeek
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# 馆藏条数「下限」补种（仅当图中 :LibraryBook 总数低于该值时批量生成无图谱边的 SEED 副本）。默认不设置或 0 表示不补种，避免孤立节点；旧演示可设为 120
# LIB_AGENT_MIN_CATALOG=0

# 推荐阅读时注入 DeepSeek 的馆藏题名匹配条数上限（默认 50，最大 120）
# READING_RECOMMEND_CATALOG_LIMIT=50

# 推荐阅读：是否在 DeepSeek 生成导读（默认开；无 API Key 时自动跳过）
# READING_RECOMMEND_DEEPSEEK=1
# 单书介绍（「介绍一下某书」）：是否调用 DeepSeek；未设置时沿用上一项的开关语义
# BOOK_INTRO_DEEPSEEK=1
# 推荐阅读「扩展推荐」表：是否调用 DeepSeek 按行生成简介（默认开；设为 0/false/off 关闭）
# READING_GRAPH_INTRO_DEEPSEEK=1
# 推荐阅读「非演示馆藏」延伸书单：DeepSeek 仅输出 JSON（默认开；与 READING_RECOMMEND_DEEPSEEK 独立，可单独关闭）
# READING_OFFCATALOG_DEEPSEEK=1
# 推荐阅读：是否请求维基/DDG 摘要作为模型参考（默认开；内网可设 READING_WEB_DISABLED=1 关闭）
# READING_WEB_DISABLED=0
# 维基 opensearch 语言域（默认 zh）
# READING_WEB_WIKI_LANG=zh
# 联网请求超时秒数
# READING_WEB_TIMEOUT=8

# Neo4j（馆藏书目与书目知识合一 :LibraryBook、借阅流水 :BorrowRecord 等均由 Neo4j 承载）
schema_cypher / import_data 与 Action Server 会自动读取本文件（不覆盖已存在的环境变量）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=libraryagent
#
# 本地无鉴权测试（Neo4j 须以关闭鉴权方式启动，例如 docker -e NEO4J_AUTH=none）：
NEO4J_AUTH_NONE=1

# GraphRAG（数据类咨询 action_data_inquiry、复合 nlu_fallback）：NL2Cypher + Neo4j 只读查询，再交给 DeepSeek 综合回答
# 需同时配置 NEO4J_* 与 DEEPSEEK_API_KEY；设为 1 可关闭整条链路
# GRAPH_RAG_DISABLED=0
# 对每个问题都跑 NL2Cypher（否则仅当问题中出现「书 / 作者 / 主题」等书目相关词时才跑，省一次调用）
# GRAPH_RAG_ALWAYS=0
# NL2Cypher 温度（越低越稳，默认 0.15）
# GRAPH_RAG_NL_TEMPERATURE=0.15
# GRAPH_RAG_NL_TIMEOUT=45
# GRAPH_RAG_MAX_ROWS=80
# GRAPH_RAG_MAX_CONTEXT_CHARS=6000
