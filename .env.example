# 复制为 .env 后填写（勿将含真实密钥的 .env 提交到 Git）

# DeepSeek OpenAI 兼容接口：用于「数据类咨询」意图的自然语言生成（见 backend/actions/actions.py 中 ActionDataInquiry）
DEEPSEEK_API_KEY="sk-29936dcf7a1f4ce39c1ede99cdbea6c9"
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TEMPERATURE=0.6
DEEPSEEK_MAX_TOKENS=1024

# 演示库 SQLite（Docker 内由 compose 挂载卷时，Action 默认使用 /app/data/library.db）
LIBRARY_SQLITE_PATH=/app/data/library.db

# Neo4j（推荐阅读 intent 优先走图谱；未启用图谱则仅用 SQLite 演示库）
schema_cypher / import_data 与 Action Server 会自动读取本文件（不覆盖已存在的环境变量）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=libraryagent
#
# 本地无鉴权测试（Neo4j 须以关闭鉴权方式启动，例如 docker -e NEO4J_AUTH=none）：
NEO4J_AUTH_NONE=1
